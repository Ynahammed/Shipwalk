# Server-side only. Copy to .env for local development.
# In Freebuff Sites, set these under Sites -> Secrets instead.

# Free Groq API key (no credit card): https://console.groq.com/keys
# Turns the five AI components from curated fallbacks into live calls.
GROQ_API_KEY=
# Optional: openai/gpt-oss-20b (default) or openai/gpt-oss-120b.
AI_MODEL=openai/gpt-oss-20b

# Free SMTP2GO API key: https://app.smtp2go.com/settings/apikeys
# Sends real verification emails with no domain purchase. Without both values
# the thank-you page shows the demo verify link instead.
SMTP2GO_API_KEY=
# A single sender address you have verified in SMTP2GO, bare address only
# (e.g. you@gmail.com). No DNS or domain ownership required.
SMTP2GO_SENDER=

# Recommended: replaces the preview passcode (ship2026).
ADMIN_PASSCODE=

# Local preview only. Set to 1 to insert the seeded demo campaign the first
# time the database is empty. Never enable this in the live environment.
# (freebuff.wrangler.jsonc already sets DEMO_DATA=1 for local Wrangler.)
DEMO_DATA=
